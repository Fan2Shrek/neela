{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} — Neela{% endblock %}

{% block body %}
    <div class="dashboard">
        <header class="dashboard__header">
            <div>
                <a class="text-muted" href="{{ path('app_project_index') }}">&larr; {{ 'project.show.back_to_projects'|trans }}</a>
                <h1>{{ project.name }}</h1>
                <p class="dashboard__subtitle">{{ project.sshLink }}</p>
            </div>
            <form method="post" action="{{ path('app_project_rescan', {id: project.id}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('rescan_project') }}">
                <button type="submit" class="button button--primary">{{ 'project.show.rescan.button'|trans }}</button>
            </form>
        </header>

        <section class="stat-tiles">
            <div class="stat-tile">
                <span class="stat-tile__value">{{ manifestCount }}</span>
                <span class="stat-tile__label">{{ 'project.show.stats.manifests'|trans }}</span>
            </div>
            <div class="stat-tile">
                <span class="stat-tile__value">{{ dependencyCount }}</span>
                <span class="stat-tile__label">{{ 'project.show.stats.dependencies'|trans }}</span>
            </div>
            <div class="stat-tile{% if lastScan %} stat-tile--{{ lastScan.status.value == 'completed' ? 'success' : (lastScan.status.value == 'failed' ? 'danger' : 'warning') }}{% endif %}">
                <span class="stat-tile__value">{{ lastScan ? lastScan.status|trans : '—' }}</span>
                <span class="stat-tile__label">{{ 'project.show.stats.last_scan'|trans }}</span>
            </div>
        </section>

        <section class="content-section">
            <h2>{{ 'project.show.outdated_dependencies_title'|trans }}</h2>

            <form method="get" class="filter-bar">
                <select name="dependency_type" class="form-input" onchange="this.form.submit()">
                    <option value="" {{ dependencyType == '' ? 'selected' : '' }}>{{ 'project.show.outdated_dependencies.filter.all'|trans }}</option>
                    <option value="require" {{ dependencyType == 'require' ? 'selected' : '' }}>{{ 'project.show.outdated_dependencies.filter.production'|trans }}</option>
                    <option value="require-dev" {{ dependencyType == 'require-dev' ? 'selected' : '' }}>{{ 'project.show.outdated_dependencies.filter.dev'|trans }}</option>
                </select>
                <noscript><button type="submit" class="button button--primary">{{ 'package.index.filters.apply'|trans }}</button></noscript>
                {% if dependencyType != '' %}
                    <a href="{{ path('app_project_show', {id: project.id}) }}" class="button button--secondary">{{ 'package.index.filters.clear'|trans }}</a>
                {% endif %}
            </form>

            {% if outdatedDependencyRows is empty %}
                <p class="empty-state">{{ 'project.show.outdated_dependencies_empty'|trans }}</p>
            {% else %}
                <table class="projects-table">
                    <thead>
                        <tr>
                            <th>{{ 'project.show.outdated_dependencies.table.package'|trans }}</th>
                            <th>{{ 'project.show.outdated_dependencies.table.type'|trans }}</th>
                            <th>{{ 'project.show.outdated_dependencies.table.current_version'|trans }}</th>
                            <th>{{ 'project.show.outdated_dependencies.table.latest_version'|trans }}</th>
                            <th>{{ 'project.show.outdated_dependencies.table.manifest'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in outdatedDependencyRows %}
                            <tr>
                                <td class="projects-table__name">{{ row.dependency.package.vendor.name }}/{{ row.dependency.package.name }}</td>
                                <td>
                                    {% if row.dependency.dependencyType == 'require-dev' %}
                                        <span class="badge badge--neutral">{{ 'project.show.outdated_dependencies.filter.dev'|trans }}</span>
                                    {% else %}
                                        <span class="badge badge--neutral">{{ 'project.show.outdated_dependencies.filter.production'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ row.dependency.lockedVersion }}</td>
                                <td><span class="badge badge--outdated">{{ row.latestVersion }}</span></td>
                                <td>{{ row.dependency.manifest.path }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>

        <section class="content-section">
            <h2>{{ 'project.show.manifests_title'|trans }}</h2>
            {% if manifestRows is empty %}
                <p class="empty-state">{{ 'project.show.manifests_empty'|trans }}</p>
            {% else %}
                <table class="projects-table">
                    <thead>
                        <tr>
                            <th>{{ 'manifest.index.table.path'|trans }}</th>
                            <th>{{ 'project.show.manifests.table.technology'|trans }}</th>
                            <th>{{ 'manifest.index.table.dependency_manager'|trans }}</th>
                            <th>{{ 'manifest.index.table.lockfile'|trans }}</th>
                            <th>{{ 'manifest.index.table.dependencies'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in manifestRows %}
                            <tr>
                                <td class="projects-table__name">{{ row.manifest.path }}</td>
                                <td>
                                    {% if row.technology %}
                                        <span class="badge badge--neutral">{{ row.technology.getLabel() }} {{ row.technologyVersion }}</span>
                                        <span class="badge badge--{{ row.technologySupportStatus.value }}">{{ ('technology_support_status.' ~ row.technologySupportStatus.value)|trans }}</span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td><span class="badge badge--neutral">{{ row.manifest.dependencyManager.name }}</span></td>
                                <td>
                                    {% if row.manifest.lockPath %}
                                        {{ row.manifest.lockPath }}
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>{{ row.dependencyCount }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>

        <section class="content-section">
            <h2>{{ 'project.show.scans_title'|trans }}</h2>
            {% if scans is empty %}
                <p class="empty-state">{{ 'project.show.scans_empty'|trans }}</p>
            {% else %}
                <table class="projects-table">
                    <thead>
                        <tr>
                            <th>{{ 'scan.index.table.manifest'|trans }}</th>
                            <th>{{ 'scan.index.table.status'|trans }}</th>
                            <th>{{ 'scan.index.table.started_at'|trans }}</th>
                            <th>{{ 'scan.index.table.completed_at'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for scan in scans %}
                            <tr>
                                <td class="projects-table__name">{{ scan.manifest.path }}</td>
                                <td>
                                    <span class="badge badge--{{ scan.status.value }}">{{ scan.status|trans }}</span>
                                    {% if scan.error %}
                                        <p class="text-muted">{{ scan.error }}</p>
                                    {% endif %}
                                </td>
                                <td>{{ scan.startedAt ? scan.startedAt|date('d/m/Y H:i') : '—' }}</td>
                                <td>{{ scan.completedAt ? scan.completedAt|date('d/m/Y H:i') : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>
    </div>
{% endblock %}
