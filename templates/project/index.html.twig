{% extends 'base.html.twig' %}

{% block title %}{{ 'project.index.title'|trans }} — Neela{% endblock %}

{% block body %}
    <div class="dashboard" data-controller="modal">
        <header class="dashboard__header">
            <div>
                <h1>{{ 'project.index.title'|trans }}</h1>
                <p class="dashboard__subtitle">{{ 'project.index.subtitle'|trans({}, null, null, projectCount) }}</p>
            </div>
            <div>
                <a class="button button--secondary" href="{{ path('app_project_discover') }}" data-action="modal#open">{{ 'project.index.discover_from_github'|trans }}</a>
                <a class="button button--primary" href="{{ path('app_project_new') }}" data-action="modal#open">+ {{ 'project.index.add_project'|trans }}</a>
            </div>
        </header>

        <section class="projects">
            {% if rows is empty %}
                <p class="empty-state">{{ 'project.index.empty_state'|trans }}</p>
            {% else %}
                <div data-controller="list-filter">
                    <div class="filter-bar">
                        <input
                            type="text"
                            placeholder="{{ 'project.index.filters.search_placeholder'|trans }}"
                            class="form-input"
                            data-list-filter-target="filter"
                            data-list-filter-field="name"
                            data-action="input->list-filter#filter"
                        >
                        <select class="form-input" data-list-filter-target="filter" data-list-filter-field="dependencyManagers" data-action="change->list-filter#filter">
                            <option value="">{{ 'package.index.filters.all_dependency_managers'|trans }}</option>
                            {% for dependencyManager in dependencyManagers %}
                                <option value="{{ dependencyManager.name|lower }}">{{ dependencyManager.name }}</option>
                            {% endfor %}
                        </select>
                        <select class="form-input" data-list-filter-target="filter" data-list-filter-field="updateStatus" data-action="change->list-filter#filter">
                            <option value="">{{ 'project.index.filters.all_update_statuses'|trans }}</option>
                            {% for status in ['up_to_date', 'partially_up_to_date', 'outdated'] %}
                                <option value="{{ status }}">{{ ('project_update_status.' ~ status)|trans }}</option>
                            {% endfor %}
                        </select>
                        <button type="button" class="button button--secondary" data-action="list-filter#reset">{{ 'package.index.filters.clear'|trans }}</button>
                    </div>

                    <p class="empty-state" data-list-filter-target="empty" hidden>{{ 'project.index.filters.no_results'|trans }}</p>

                    <table class="projects-table">
                        <thead>
                            <tr>
                                <th>{{ 'project.index.table.project'|trans }}</th>
                                <th>{{ 'project.index.table.dependency_managers'|trans }}</th>
                                <th>{{ 'project.index.table.manifests'|trans }}</th>
                                <th>{{ 'project.index.table.vulnerabilities'|trans }}</th>
                                <th>{{ 'project.index.table.last_scan'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in rows %}
                                <tr
                                    data-list-filter-target="row"
                                    data-name="{{ row.project.name|lower }}"
                                    data-dependency-managers="{{ row.dependencyManagers|map(name => name|lower)|join(' ') }}"
                                    data-update-status="{{ row.updateStatus.value|default('') }}"
                                >
                                    <td class="projects-table__name"><a href="{{ path('app_project_show', {id: row.project.id}) }}">{{ row.project.name }}</a></td>
                                    <td>
                                        {% for name in row.dependencyManagers %}
                                            <span class="badge badge--neutral">{{ name }}</span>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endfor %}
                                    </td>
                                    <td>{{ row.manifestCount }}</td>
                                    <td>
                                        {% if row.vulnerabilityCount > 0 %}
                                            <span class="badge badge--{{ row.maxVulnerabilitySeverity|default('unknown')|lower }}">{{ row.vulnerabilityCount }} {{ row.maxVulnerabilitySeverity|default('project.show.vulnerabilities.severity_unknown'|trans) }}</span>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if row.lastScan %}
                                            <span class="badge badge--{{ row.lastScan.status.value }}">{{ row.lastScan.status|trans }}</span>
                                            {% if row.lastScan.startedAt %}
                                                <span class="text-muted">{{ row.lastScan.startedAt|date('d/m/Y H:i') }}</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">{{ 'project.index.never_scanned'|trans }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>

        <twig:Modal id="project-modal" />
    </div>
{% endblock %}
