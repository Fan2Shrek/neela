<dialog id="{{ id }}" class="modal" data-modal-target="dialog" data-action="click->modal#backdropClose">
    <div class="modal__box">
        <button type="button" class="modal__close" data-action="modal#close" aria-label="{{ 'common.close'|trans }}">&times;</button>
        <div data-modal-target="content"></div>
    </div>
</dialog>
