{% extends 'base.html.twig' %}

{% block title %}Neela — Dependency Monitor{% endblock %}

{% block body %}
    <div class="dashboard">
        <header class="dashboard__header">
            <h1>{{ 'dashboard.title'|trans }}</h1>
        </header>

        <section class="stat-tiles">
            <div class="stat-tile">
                <span class="stat-tile__value">{{ projectCount }}</span>
                <span class="stat-tile__label">{{ 'dashboard.projects_tracked'|trans({}, null, null, projectCount) }}</span>
            </div>
            <div class="stat-tile stat-tile--success">
                <span class="stat-tile__value">{{ scanStatusCounts.completed|default(0) }}</span>
                <span class="stat-tile__label">{{ 'dashboard.scans_up_to_date'|trans }}</span>
            </div>
            <div class="stat-tile stat-tile--warning">
                <span class="stat-tile__value">{{ (scanStatusCounts.pending|default(0)) + (scanStatusCounts.in_progress|default(0)) }}</span>
                <span class="stat-tile__label">{{ 'dashboard.scans_pending'|trans }}</span>
            </div>
            <div class="stat-tile stat-tile--danger">
                <span class="stat-tile__value">{{ scanStatusCounts.failed|default(0) }}</span>
                <span class="stat-tile__label">{{ 'dashboard.scans_failed'|trans }}</span>
            </div>
        </section>
    </div>
{% endblock %}
