{% extends 'base.html.twig' %}

{% block title %}Neela — Dependency Monitor{% endblock %}

{% block body %}
    <div class="dashboard" data-controller="modal">
        <header class="dashboard__header">
            <div>
                <h1>Neela</h1>
                <p class="dashboard__subtitle">Dependency Monitor</p>
            </div>
            <a class="button button--primary" href="{{ path('app_project_new') }}" data-action="modal#open">+ {{ 'dashboard.add_project'|trans }}</a>
        </header>

        <section class="stat-tiles">
            <div class="stat-tile">
                <span class="stat-tile__value">{{ projectCount }}</span>
                <span class="stat-tile__label">{{ 'dashboard.projects_tracked'|trans({}, null, null, projectCount) }}</span>
            </div>
            <div class="stat-tile stat-tile--success">
                <span class="stat-tile__value">{{ scanStatusCounts.completed|default(0) }}</span>
                <span class="stat-tile__label">{{ 'dashboard.scans_up_to_date'|trans }}</span>
            </div>
            <div class="stat-tile stat-tile--warning">
                <span class="stat-tile__value">{{ (scanStatusCounts.pending|default(0)) + (scanStatusCounts.in_progress|default(0)) }}</span>
                <span class="stat-tile__label">{{ 'dashboard.scans_pending'|trans }}</span>
            </div>
            <div class="stat-tile stat-tile--danger">
                <span class="stat-tile__value">{{ scanStatusCounts.failed|default(0) }}</span>
                <span class="stat-tile__label">{{ 'dashboard.scans_failed'|trans }}</span>
            </div>
        </section>

        <section class="projects">
            {% if rows is empty %}
                <p class="empty-state">{{ 'dashboard.empty_state'|trans }}</p>
            {% else %}
                <table class="projects-table">
                    <thead>
                        <tr>
                            <th>{{ 'dashboard.table.project'|trans }}</th>
                            <th>{{ 'dashboard.table.dependency_managers'|trans }}</th>
                            <th>{{ 'dashboard.table.manifests'|trans }}</th>
                            <th>{{ 'dashboard.table.last_scan'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td class="projects-table__name">{{ row.project.name }}</td>
                                <td>
                                    {% for name in row.dependencyManagers %}
                                        <span class="badge badge--neutral">{{ name }}</span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endfor %}
                                </td>
                                <td>{{ row.manifestCount }}</td>
                                <td>
                                    {% if row.lastScan %}
                                        <span class="badge badge--{{ row.lastScan.status.value }}">{{ row.lastScan.status|trans }}</span>
                                        {% if row.lastScan.startedAt %}
                                            <span class="text-muted">{{ row.lastScan.startedAt|date('d/m/Y H:i') }}</span>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted">{{ 'dashboard.never_scanned'|trans }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>

        <twig:Modal id="project-modal" />
    </div>
{% endblock %}
