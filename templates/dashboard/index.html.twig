{% extends 'base.html.twig' %}

{% block title %}Neela — Dependency Monitor{% endblock %}

{% block body %}
    <div class="dashboard">
        <header class="dashboard__header">
            <h1>{{ 'dashboard.title'|trans }}</h1>
        </header>

        <section class="stat-tiles">
            <div class="stat-tile">
                <span class="stat-tile__value">{{ projectCount }}</span>
                <span class="stat-tile__label">{{ 'dashboard.projects_tracked'|trans({}, null, null, projectCount) }}</span>
            </div>
            <div class="stat-tile stat-tile--success">
                <span class="stat-tile__value">{{ updateStatusCounts.up_to_date|default(0) }}</span>
                <span class="stat-tile__label">{{ 'dashboard.projects_up_to_date'|trans }}</span>
            </div>
            <div class="stat-tile stat-tile--warning">
                <span class="stat-tile__value">{{ updateStatusCounts.partially_up_to_date|default(0) }}</span>
                <span class="stat-tile__label">{{ 'dashboard.projects_partially_up_to_date'|trans }}</span>
            </div>
            <div class="stat-tile stat-tile--danger">
                <span class="stat-tile__value">{{ updateStatusCounts.outdated|default(0) }}</span>
                <span class="stat-tile__label">{{ 'dashboard.projects_outdated'|trans }}</span>
            </div>
            <div class="stat-tile{% if vulnerableDependencyCount > 0 %} stat-tile--danger{% endif %}">
                <span class="stat-tile__value">{{ vulnerableDependencyCount }}</span>
                <span class="stat-tile__label">{{ 'dashboard.vulnerable_dependencies'|trans }}</span>
            </div>
        </section>

        <section class="content-section">
            <h2>{{ 'dashboard.projects_needing_update_title'|trans }}</h2>
            {% if projectsNeedingUpdate is empty %}
                <p class="empty-state">{{ 'dashboard.projects_needing_update_empty'|trans }}</p>
            {% else %}
                <table class="projects-table">
                    <thead>
                        <tr>
                            <th>{{ 'project.index.table.project'|trans }}</th>
                            <th>{{ 'dashboard.projects_needing_update_status'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in projectsNeedingUpdate %}
                            <tr>
                                <td class="projects-table__name"><a href="{{ path('app_project_show', {id: row.project.id}) }}">{{ row.project.name }}</a></td>
                                <td><span class="badge badge--{{ row.status.value }}">{{ ('project_update_status.' ~ row.status.value)|trans }}</span></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>

        <section class="content-section">
            <h2>{{ 'dashboard.projects_with_vulnerabilities_title'|trans }}</h2>
            {% if projectsWithVulnerabilities is empty %}
                <p class="empty-state">{{ 'dashboard.projects_with_vulnerabilities_empty'|trans }}</p>
            {% else %}
                <table class="projects-table">
                    <thead>
                        <tr>
                            <th>{{ 'project.index.table.project'|trans }}</th>
                            <th>{{ 'project.index.table.vulnerabilities'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in projectsWithVulnerabilities %}
                            <tr>
                                <td class="projects-table__name"><a href="{{ path('app_project_show', {id: row.project.id}) }}">{{ row.project.name }}</a></td>
                                <td><span class="badge badge--{{ row.maxSeverity|default('unknown')|lower }}">{{ row.count }} {{ row.maxSeverity|default('project.show.vulnerabilities.severity_unknown'|trans) }}</span></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>

        <section class="content-section">
            <h2>{{ 'dashboard.scans_title'|trans }}</h2>
            <div class="stat-tiles">
                <div class="stat-tile stat-tile--success">
                    <span class="stat-tile__value">{{ scanStatusCounts.completed|default(0) }}</span>
                    <span class="stat-tile__label">{{ 'dashboard.scans_up_to_date'|trans }}</span>
                </div>
                <div class="stat-tile stat-tile--warning">
                    <span class="stat-tile__value">{{ (scanStatusCounts.pending|default(0)) + (scanStatusCounts.in_progress|default(0)) }}</span>
                    <span class="stat-tile__label">{{ 'dashboard.scans_pending'|trans }}</span>
                </div>
                <div class="stat-tile stat-tile--danger">
                    <span class="stat-tile__value">{{ scanStatusCounts.failed|default(0) }}</span>
                    <span class="stat-tile__label">{{ 'dashboard.scans_failed'|trans }}</span>
                </div>
            </div>
        </section>

        <section class="content-section">
            <h2>{{ 'dashboard.background_tasks_title'|trans }}</h2>
            <div class="stat-tiles">
                <div class="stat-tile">
                    <span class="stat-tile__value">{{ asyncQueueDepth ?? '—' }}</span>
                    <span class="stat-tile__label">{{ 'dashboard.background_tasks_pending'|trans }}</span>
                </div>
                <div class="stat-tile stat-tile--danger">
                    <span class="stat-tile__value">{{ failedQueueDepth ?? '—' }}</span>
                    <span class="stat-tile__label">{{ 'dashboard.background_tasks_failed'|trans }}</span>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
