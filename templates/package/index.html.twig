{% extends 'base.html.twig' %}

{% block title %}{{ 'package.index.title'|trans }} — Neela{% endblock %}

{% block body %}
    <div class="dashboard">
        <header class="dashboard__header">
            <div>
                <h1>{{ 'package.index.title'|trans }}</h1>
                <p class="dashboard__subtitle">{{ 'package.index.subtitle'|trans({}, null, null, packageCount) }}</p>
            </div>
        </header>

        <form method="get" class="filter-bar">
            <input
                type="text"
                name="search"
                value="{{ search }}"
                placeholder="{{ 'package.index.filters.search_placeholder'|trans }}"
                class="form-input"
            >
            <select name="dependency_manager" class="form-input">
                <option value="">{{ 'package.index.filters.all_dependency_managers'|trans }}</option>
                {% for dependencyManager in dependencyManagers %}
                    <option value="{{ dependencyManager.name }}" {{ dependencyManager.name == dependencyManagerName ? 'selected' : '' }}>{{ dependencyManager.name }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="button button--primary">{{ 'package.index.filters.apply'|trans }}</button>
            {% if isFiltered %}
                <a href="{{ path('app_package_index') }}" class="button button--secondary">{{ 'package.index.filters.clear'|trans }}</a>
            {% endif %}
        </form>

        <section class="projects">
            {% if rows is empty %}
                <p class="empty-state">{{ (isFiltered ? 'package.index.filters.no_results' : 'package.index.empty_state')|trans }}</p>
            {% else %}
                <table class="projects-table">
                    <thead>
                        <tr>
                            <th>{{ 'package.index.table.package'|trans }}</th>
                            <th>{{ 'package.index.table.dependency_manager'|trans }}</th>
                            <th>{{ 'package.index.table.projects'|trans }}</th>
                            <th>{{ 'package.index.table.dependencies'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td class="projects-table__name">{{ row.package.vendor.name }}/{{ row.package.name }}</td>
                                <td><span class="badge badge--neutral">{{ row.package.vendor.dependencyManager.name }}</span></td>
                                <td>{{ row.projectCount }}</td>
                                <td>{{ row.dependencyCount }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>
    </div>
{% endblock %}
