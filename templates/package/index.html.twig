{% extends 'base.html.twig' %}

{% block title %}{{ 'package.index.title'|trans }} — Neela{% endblock %}

{% block body %}
    <div class="dashboard">
        <header class="dashboard__header">
            <div>
                <h1>{{ 'package.index.title'|trans }}</h1>
                <p class="dashboard__subtitle">{{ 'package.index.subtitle'|trans({}, null, null, packageCount) }}</p>
            </div>
        </header>

        <section class="projects">
            {% if rows is empty %}
                <p class="empty-state">{{ 'package.index.empty_state'|trans }}</p>
            {% else %}
                <table class="projects-table">
                    <thead>
                        <tr>
                            <th>{{ 'package.index.table.package'|trans }}</th>
                            <th>{{ 'package.index.table.dependency_manager'|trans }}</th>
                            <th>{{ 'package.index.table.projects'|trans }}</th>
                            <th>{{ 'package.index.table.dependencies'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td class="projects-table__name">{{ row.package.vendor.name }}/{{ row.package.name }}</td>
                                <td><span class="badge badge--neutral">{{ row.package.vendor.dependencyManager.name }}</span></td>
                                <td>{{ row.projectCount }}</td>
                                <td>{{ row.dependencyCount }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>
    </div>
{% endblock %}
