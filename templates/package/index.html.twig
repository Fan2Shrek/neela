{% extends 'base.html.twig' %}

{% block title %}{{ 'package.index.title'|trans }} — Neela{% endblock %}

{% block body %}
    <div class="dashboard">
        <header class="dashboard__header">
            <div>
                <h1>{{ 'package.index.title'|trans }}</h1>
                <p class="dashboard__subtitle">{{ 'package.index.subtitle'|trans({}, null, null, packageCount) }}</p>
            </div>
        </header>

        <section class="projects">
            {% if rows is empty %}
                <p class="empty-state">{{ 'package.index.empty_state'|trans }}</p>
            {% else %}
                <div data-controller="list-filter">
                    <div class="filter-bar">
                        <input
                            type="text"
                            placeholder="{{ 'package.index.filters.search_placeholder'|trans }}"
                            class="form-input"
                            data-list-filter-target="filter"
                            data-list-filter-field="name"
                            data-action="input->list-filter#filter"
                        >
                        <select class="form-input" data-list-filter-target="filter" data-list-filter-field="dependencyManager" data-action="change->list-filter#filter">
                            <option value="">{{ 'package.index.filters.all_dependency_managers'|trans }}</option>
                            {% for dependencyManager in dependencyManagers %}
                                <option value="{{ dependencyManager.name|lower }}">{{ dependencyManager.name }}</option>
                            {% endfor %}
                        </select>
                        <button type="button" class="button button--secondary" data-action="list-filter#reset">{{ 'package.index.filters.clear'|trans }}</button>
                    </div>

                    <p class="empty-state" data-list-filter-target="empty" hidden>{{ 'package.index.filters.no_results'|trans }}</p>

                    <table class="projects-table">
                        <thead>
                            <tr>
                                <th>{{ 'package.index.table.package'|trans }}</th>
                                <th>{{ 'package.index.table.dependency_manager'|trans }}</th>
                                <th>{{ 'package.index.table.projects'|trans }}</th>
                                <th>{{ 'package.index.table.dependencies'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in rows %}
                                <tr
                                    data-list-filter-target="row"
                                    data-name="{{ (row.package.vendor.name ~ '/' ~ row.package.name)|lower }}"
                                    data-dependency-manager="{{ row.package.vendor.dependencyManager.name|lower }}"
                                >
                                    <td class="projects-table__name"><a href="{{ path('app_package_show', {id: row.package.id}) }}">{{ row.package.vendor.name }}/{{ row.package.name }}</a></td>
                                    <td><span class="badge badge--neutral">{{ row.package.vendor.dependencyManager.name }}</span></td>
                                    <td>{{ row.projectCount }}</td>
                                    <td>{{ row.dependencyCount }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
